};
service : (Args_8) -> {
  get_config : (GetConfigArgs) -> (GetConfigResponse) query;
  list_neurons : () -> (ListNeuronsResponse) query;
  manage_nns_neuron : (Args) -> (Response);
  manage_sns_neuron : (Args_1) -> (Response);
  stake_nns_neuron : (Args_2) -> (Response_1);
  stake_sns_neuron : (Args_3) -> (Response_2);
  update_config : (Args_4) -> (Response_3);
  update_goldao_config : (Args_5) -> (Response_4);
  update_icp_config : (Args_6) -> (Response_5);
  update_ogy_config : (Args_7) -> (Response_5);
