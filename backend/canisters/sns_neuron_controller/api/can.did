};
type Args_2 = record { amount : nat64; add_disolve_delay : opt nat32 };
type Args_3 = record {
  neuron_type : NeuronType;
  amount : nat64;
  add_disolve_delay : opt nat32;
};
type Args_4 = record { rewards_destination : opt principal };
type Args_5 = record {
