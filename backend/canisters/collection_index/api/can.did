type Args = variant { Upgrade : UpgradeArgs; Init : InitArgs };
// Represents a semantic version number following the MAJOR.MINOR.PATCH format.
// 
// # Examples
// 
// ```
// use types::BuildVersion;
// 
// let version = BuildVersion::new(1, 2, 3);
// assert_eq!(version.to_string(), "1.2.3");
// 
// let parsed = "1.2.3".parse::<BuildVersion>().unwrap();
// assert_eq!(version, parsed);
// ```
type BuildVersion = record {
  // Major version number, incremented for incompatible API changes
  major : nat32;
  // Minor version number, incremented for backwards-compatible functionality additions
  minor : nat32;
  // Patch version number, incremented for backwards-compatible bug fixes
  patch : nat32;
};
type Category = record { active : bool; collection_count : nat64 };
type Collection = record {
  name : opt text;
  canister_id : principal;
  locked_value_usd : opt nat64;
  is_promoted : bool;
  category : opt text;
};
type GetCollectionByPrincipal = variant { CollectionNotFound };
type GetCollectionsArgs = record {
  categories : opt vec text;
  offset : nat64;
  limit : nat64;
};
type GetCollectionsError = variant { CategoryNotFound : text };
type GetCollectionsResult = record {
  total_pages : nat64;
  collections : vec Collection;
};
type InitArgs = record {
  test_mode : bool;
  claimlink_canister_id : principal;
  authorized_principals : vec principal;
  version : BuildVersion;
  commit_hash : text;
};
type InsertCategoryArgs = record { category_name : text };
type InsertCategoryError = variant { CategoryAlreadyExists };
type InsertCollectionArgs = record {
  locked_value_usd : opt nat64;
  is_promoted : bool;
  collection_canister_id : principal;
  category : opt text;
};
type InsertCollectionError = variant {
  GenericOrigynNftError : text;
  TargetCanisterIdNotOrigyn;
  CollectionAlreadyExists;
  CategoryNotFound : text;
};
type Job = variant { SyncSupplies; ComputeStats; SyncCollections };
type OverallStats = record {
  total_collections : nat64;
  total_value_locked : nat64;
};
type RemoveCategoryError = variant { CategoryNotFound };
type RemoveCollectionArgs = record { collection_canister_id : principal };
type RemoveCollectionError = variant { CollectionNotFound };
// Clears a collection's admin-configured USD-per-item price. Once removed,
// the claimlink sync job stops valuing that collection until a new price is
// set again.
type RemoveItemPriceArgs = record { collection_canister_id : principal };
type Result = variant { Ok : bool; Err : text };
type Result_1 = variant { Ok : vec record { text; Category }; Err };
type Result_10 = variant { Ok; Err : text };
type Result_11 = variant { Ok; Err : TogglePromotedError };
type Result_12 = variant { Ok; Err : UpdateCollectionError };
type Result_2 = variant { Ok : Collection; Err : GetCollectionByPrincipal };
type Result_3 = variant {
  Ok : GetCollectionsResult;
  Err : GetCollectionsError;
};
type Result_4 = variant { Ok : OverallStats; Err };
type Result_5 = variant { Ok; Err : InsertCategoryError };
type Result_6 = variant { Ok; Err : InsertCollectionError };
type Result_7 = variant { Ok; Err : RemoveCategoryError };
type Result_8 = variant { Ok; Err : RemoveCollectionError };
type Result_9 = variant { Ok; Err : SetItemPriceError };
type SearchCollectionsArg = record {
  categories : opt vec text;
  search_string : text;
  offset : nat64;
  limit : nat64;
};
type SetCategoryVisibility = record { hidden : bool; category_name : text };
// Sets (or replaces) the admin-configured USD-per-item price for a
// collection's NFTs. The claimlink sync job multiplies this by the
// collection's current `icrc7_total_supply` to derive its locked value.
type SetItemPriceArgs = record {
  collection_canister_id : principal;
  price_usd : nat64;
};
type SetItemPriceError = variant {
  CollectionNotFound;
  CollectionIsArbitraryTvl;
};
type TogglePromotedArgs = record { collection_canister_id : principal };
type TogglePromotedError = variant { CollectionNotFound };
type UpdateCollectionArgs = record {
  locked_value_usd : opt nat64;
  item_price_usd : opt nat64;
  collection_canister_id : principal;
  category_name : opt text;
};
type UpdateCollectionError = variant {
  CollectionNotFound;
  CategoryNotFound : text;
  ConflictingPricingMode;
};
type UpgradeArgs = record { version : BuildVersion; commit_hash : text };
service : (Args) -> {
  add_authorised_principal : (principal) -> (Result);
  get_categories : () -> (Result_1) query;
  get_collection_by_principal : (principal) -> (Result_2) query;
  get_collections : (GetCollectionsArgs) -> (Result_3) query;
  get_item_prices : () -> (vec record { principal; nat64 }) query;
  get_overall_stats : (null) -> (Result_4) query;
  get_user_collections : (opt principal) -> (vec Collection);
  insert_category : (InsertCategoryArgs) -> (Result_5);
  insert_collection : (InsertCollectionArgs) -> (Result_6);
  remove_category : (InsertCategoryArgs) -> (Result_7);
  remove_collection : (RemoveCollectionArgs) -> (Result_8);
  remove_item_price : (RemoveItemPriceArgs) -> (Result_9);
  run_job : (Job) -> (Result_10);
  search_collections : (SearchCollectionsArg) -> (GetCollectionsResult) query;
  set_category_visibility : (SetCategoryVisibility) -> (Result_7);
  set_claimlink_canister_id : (principal) -> (null);
  set_item_price : (SetItemPriceArgs) -> (Result_9);
  toggle_promoted : (TogglePromotedArgs) -> (Result_11);
  update_collection : (UpdateCollectionArgs) -> (Result_12);
}
