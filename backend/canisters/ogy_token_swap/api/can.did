// [Account](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#value)
// representation of ledgers supporting the ICRC-1 standard.
type Account = record { owner : principal; subaccount : opt blob };
type Args = record { block_index : nat64 };
type Args_1 = record { of : opt principal };
type Args_2 = record { block_index : nat64; user : opt principal };
type Args_3 = variant { Upgrade : UpgradeArgs; Init : InitArgs };
type BlockFailReason = variant {
  ReceiverNotCorrectAccountId : blob;
  NotFound;
  QueryRequestFailed;
  SenderNotPrincipalDefaultSubaccount : blob;
  InvalidOperation;
  AmountTooSmall;
};
// Represents a semantic version number following the MAJOR.MINOR.PATCH format.
// 
// # Examples
// 
// ```
// use types::BuildVersion;
// 
// let version = BuildVersion::new(1, 2, 3);
// assert_eq!(version.to_string(), "1.2.3");
// 
// let parsed = "1.2.3".parse::<BuildVersion>().unwrap();
// assert_eq!(version, parsed);
// ```
type BuildVersion = record {
  // Major version number, incremented for incompatible API changes
  major : nat32;
  // Minor version number, incremented for backwards-compatible functionality additions
  minor : nat32;
  // Patch version number, incremented for backwards-compatible bug fixes
  patch : nat32;
};
type BurnFailReason = variant {
  TransferError : TransferError;
  CallError : text;
  TokenBalanceAndSwapRequestDontMatch;
};
type BurnRequestArgs = record {
  memo : nat64;
  from_subaccount : opt blob;
  created_at_time : opt Timestamp;
  amount : Tokens;
};
type ImpossibleErrorReason = variant { AmountNotFound; PrincipalNotFound };
type InitArgs = record {
  ogy_legacy_minting_account_principal : principal;
  test_mode : bool;
  authorized_principals : vec principal;
  version : BuildVersion;
  ogy_new_ledger_canister_id : principal;
  commit_hash : text;
  ogy_legacy_ledger_canister_id : principal;
};
type Response = variant { Success : SwapInfo; InternalError : text };
type Response_1 = variant {
  NotAuthorized : text;
  Success : blob;
  MaxCapacityOfListReached;
  MaxCapacityOfSwapsReached;
};
type Response_2 = variant { Success : nat; InternalError : text };
type Response_3 = variant {
  TransferError : text;
  FailedToFetchBalance : text;
  InsufficientBalance : nat64;
  TransferCallError : text;
  NoRecordOfSubaccountRequestFound;
  Success : nat64;
  InternalError : text;
};
type SwapError = variant {
  BlockFailed : BlockFailReason;
  BurnFailed : BurnFailReason;
  UnexpectedError : ImpossibleErrorReason;
  TransferFailed : TransferFailReason;
};
type SwapInfo = record {
  status : SwapStatus;
  last_request : nat64;
  "principal" : principal;
  token_swap_block_index : opt nat;
  is_archived : bool;
  burn_block_index : opt nat64;
  first_request : nat64;
  amount : nat64;
};
type SwapStatistics = record {
  number_of_completed_swaps : nat64;
  user_swaps : vec record { principal; UserSwap };
  number_of_failed_swaps : nat64;
  total_amount_swapped : nat64;
  number_of_attempted_swaps : nat64;
};
type SwapStatus = variant {
  Failed : SwapError;
  BurnSuccess;
  Init;
  BlockRequest : nat64;
  Complete : nat;
  TransferRequest : TransferRequestArgs;
  BurnRequest : BurnRequestArgs;
  BlockValid;
};
// Number of nanoseconds from the UNIX epoch in UTC timezone.
type Timestamp = record {
  // Number of nanoseconds from the UNIX epoch in UTC timezone.
  timestamp_nanos : nat64;
};
// A type for representing amounts of Tokens.
// 
// # Panics
// 
// * Arithmetics (addition, subtraction) on the Tokens type panics if the underlying type
// overflows.
type Tokens = record { e8s : nat64 };
// Error of the `transfer` call.
type TransferError = variant {
  // The request is too old.
  // The ledger only accepts requests created within a 24-hour window.
  // This is a non-recoverable error.
  TxTooOld : record {
    // The permitted duration between `created_at_time` and now.
    allowed_window_nanos : nat64;
  };
  // The fee that the caller specified in the transfer request was not the one that the ledger expects.
  // The caller can change the transfer fee to the `expected_fee` and retry the request.
  BadFee : record {
    // The account specified by the caller doesn't have enough funds.
    expected_fee : Tokens;
  };
  // The ledger has already executed the request.
  TxDuplicate : record {
    // The index of the block containing the original transaction.
    duplicate_of : nat64;
  };
  // The caller specified a `created_at_time` that is too far in the future.
  // The caller can retry the request later.
  // This may also be caused by clock desynchronization.
  TxCreatedInFuture;
  // The caller did not have enough ICP in the specified subaccount.
  InsufficientFunds : record {
    // The caller's balance.
    balance : Tokens;
  };
};
// Errors defined for the
// [ICRC-1 `transfer`](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-1/README.md#icrc1_transfer-)
// endpoint.
type TransferError_1 = variant {
  GenericError : record { message : text; error_code : nat };
  TemporarilyUnavailable;
  BadBurn : record { min_burn_amount : nat };
  Duplicate : record { duplicate_of : nat };
  BadFee : record { expected_fee : nat };
  CreatedInFuture : record { ledger_time : nat64 };
  TooOld;
  InsufficientFunds : record { balance : nat };
};
type TransferFailReason = variant {
  TransferError : TransferError_1;
  CallError : text;
};
type TransferRequestArgs = record {
  to : Account;
  memo : opt blob;
  created_at_time : opt nat64;
  amount : nat;
};
type UpgradeArgs = record { version : BuildVersion; commit_hash : text };
type UserSwap = record {
  desposit_account : blob;
  swaps : nat64;
  amount : nat64;
};
service : (Args_3) -> {
  get_swap_info : (Args) -> (Response) query;
  is_caller_whitelisted : () -> (bool) query;
  list_swapping_statistics : () -> (SwapStatistics) query;
  request_deposit_account : (Args_1) -> (Response_1);
  swap_tokens : (Args_2) -> (Response_2);
  withdraw_deposit : () -> (Response_3);
}
