// [Account](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#value)
// representation of ledgers supporting the ICRC-1 standard.
type Account = record { owner : principal; subaccount : opt blob };
type Alert = record {
  // Nanoseconds since the Unix epoch.
  time : nat64;
  message : text;
  severity : Severity;
};
// Information about where to find archived blocks. Returned as part of [`GetBlocksResult`].
type ArchivedBlocks = record {
  args : vec GetBlocksRequest;
  callback : func (vec GetBlocksRequest) -> (GetBlocksResult) query;
};
type Args = record { "principal" : opt principal; canister_id : principal };
type Args_1 = variant { Upgrade : UpgradeArgs; Init : InitArgs };
// A block with an ID. Returned as part of [`GetBlocksResult`].
type BlockWithId = record { id : nat; block : ICRC3Value };
type BridgeConfig = record {
  // `key_1` in production, `test_key_1` on staging.
  ecdsa_key_name : text;
  admin_action_max_validity_secs : nat64;
  // ORIGYN SNS governance, the only caller of `bridge_sns_action`.
  sns_governance : principal;
  chains : vec ChainConfig;
  admin_action_validity_secs : nat64;
  evm_rpc_canister : principal;
};
type BridgeError = variant {
  Paused;
  // The ledger refused the burn; nothing changed.
  Burn : TransferFromError;
  Busy;
  UnknownChain;
  // Keys not loaded, a chain has no start block, or this chain is stopped.
  NotReady : text;
  ZeroAmount;
  InvalidRecipient;
};
// Authorized principals can only pause: a `true` sets the flag, a `false` leaves it as it is.
type BridgePauseArgs = record { inbound : bool; outbound : bool };
type BridgeSnsAction = variant {
  SignEvmAdmin : vec EvmAdminRequest;
  Resolve : vec ResolveAction;
  SetIcpPaused : record { inbound : opt bool; outbound : opt bool };
};
type BridgeStatus = record {
  claims_signer : opt text;
  paused_out : bool;
  supply_guard : SupplyGuardStatus;
  alerts : vec Alert;
  admin_signer : opt text;
  paused_in : bool;
  queue : QueueSizes;
  // The canister's cycle balance.
  cycles : nat;
  configured : bool;
  chains : vec ChainStatus;
  alerts_total : nat64;
  out_pending : nat;
  bridged_out : nat;
  outbound : OutboundCounts;
};
type BridgeToEvmArgs = record {
  chain : EvmChain;
  recipient : text;
  from_subaccount : opt blob;
  amount : nat;
};
type BridgeUpgrade = record {
  chain_resets : vec ChainReset;
  // Replaces the whole config when present.
  config : opt BridgeConfig;
};
// Represents a semantic version number following the MAJOR.MINOR.PATCH format.
// 
// # Examples
// 
// ```
// use types::BuildVersion;
// 
// let version = BuildVersion::new(1, 2, 3);
// assert_eq!(version.to_string(), "1.2.3");
// 
// let parsed = "1.2.3".parse::<BuildVersion>().unwrap();
// assert_eq!(version, parsed);
// ```
type BuildVersion = record {
  // Major version number, incremented for incompatible API changes
  major : nat32;
  // Minor version number, incremented for backwards-compatible functionality additions
  minor : nat32;
  // Patch version number, incremented for backwards-compatible bug fixes
  patch : nat32;
};
type ChainConfig = record {
  confirmations : nat64;
  // The token proxy address, the same on both chains.
  token : text;
  chain : EvmChain;
  scrape_interval_secs : nat64;
  // At most 500.
  max_window_blocks : nat64;
  // The LayerZero EndpointV2 address.
  lz_endpoint : text;
  // 1 (or Sepolia 11155111) for Ethereum, 8453 (or Base Sepolia 84532) for Base.
  chain_id : nat64;
  // Public HTTPS endpoint for `eth_blockNumber`, without an API key.
  head_rpc_url : text;
  // LayerZero endpoint id: 30101 for Ethereum, 30184 for Base.
  lz_eid : nat32;
  // Exactly two distinct providers: both built-in for the chain id, or both `Custom`.
  providers : vec EvmProvider;
  // 1 to 50.
  log_batch_size : nat32;
};
// Restarts a stopped chain from the given cursor.
type ChainReset = record {
  chain : EvmChain;
  last_scraped_block : nat64;
  next_burn_id : nat64;
};
type ChainStatus = record {
  last_error : opt text;
  token : text;
  stopped : opt text;
  chain : EvmChain;
  window : opt WindowStatus;
  last_scraped_block : nat64;
  chain_id : nat64;
  supply : opt SupplyReadingStatus;
  next_burn_id : nat64;
  failed_ticks : nat32;
  last_ok_at : opt nat64;
  start_block : opt nat64;
};
type ConsentInfo = record {
  metadata : ConsentMessageMetadata;
  consent_message : ConsentMessage;
};
type ConsentMessage = variant {
  FieldsDisplayMessage : FieldsDisplay;
  GenericDisplayMessage : text;
};
type ConsentMessageMetadata = record {
  utc_offset_minutes : opt int16;
  language : text;
};
type ConsentMessageRequest = record {
  arg : blob;
  method : text;
  user_preferences : ConsentMessageSpec;
};
type ConsentMessageSpec = record {
  metadata : ConsentMessageMetadata;
  device_spec : opt DisplayMessageType;
};
type CustomFractionalizationConfig = record {
  per_token_config : vec record { nat; GeneralFractionalizationConfig };
};
type DisplayMessageType = variant { GenericDisplay; FieldsDisplay };
type Duration = record { secs : nat64; nanos : nat32 };
type ErrorInfo = record { description : text };
type EvmAdminAction = variant {
  SetSendLibrary : record { eid : nat32; lib : text };
  CancelNonce : record { nonce : nat64 };
  SetLzReceiveGas : record { gas : nat; dst_eid : nat32 };
  Upgrade : record { implementation : text; code_hash : text };
  SetExecutorConfig : record {
    eid : nat32;
    lib : text;
    max_message_size : nat32;
    executor : text;
  };
  SetUlnConfig : record {
    eid : nat32;
    lib : text;
    confirmations : nat64;
    required_dvns : vec text;
    optional_dvns : vec text;
    optional_threshold : nat8;
  };
  SetAdminSigner : record { signer : text };
  BurnLzMessage : record {
    sender : text;
    src_eid : nat32;
    nonce : nat64;
    payload_hash : text;
  };
  SetOperator : record { operator : opt text };
  SetReceiveLibrary : record { eid : nat32; lib : text; grace_period : nat };
  SetMinBurnToIcp : record { amount : nat };
  SetIcpSigner : record { signer : text };
  SetPeer : record { eid : nat32; peer : text };
  SetPaused : record { lz_paused : bool; icp_bridge_paused : bool };
};
type EvmAdminRequest = record {
  chain : EvmChain;
  // One signed batch, run in order.
  actions : vec EvmAdminAction;
  // Defaults to 7 days, at most 30.
  valid_for_secs : opt nat64;
};
type EvmCall = record { data : blob; target : text };
type EvmChain = variant { Base; Ethereum };
// A provider of the EVM RPC canister. A built-in one maps to the EVM RPC canister's providers
// for the chain id: Sepolia (11155111) has no Llama or Cloudflare, Base (8453) has no
// Cloudflare, and Base Sepolia (84532) has no built-in provider at all. `Custom` is an HTTPS
// JSON-RPC URL sent with no headers, so no API key ever sits in canister state.
type EvmProvider = variant {
  Alchemy;
  Llama;
  BlockPi;
  Cloudflare;
  PublicNode;
  Ankr;
  Custom : record { url : text };
};
type EvmVoucher = record {
  token : text;
  // `0x` and 65 bytes of hex.
  signature : text;
  recipient : text;
  icp_burn_index : nat64;
  chain_id : nat64;
  amount : nat;
};
type FieldsDisplay = record {
  fields : vec record { text; Value };
  intent : text;
};
type FractionalizationConfig = variant {
  Custom : CustomFractionalizationConfig;
  General : GeneralFractionalizationConfig;
};
type GeneralError = variant {
  InvalidConfig : text;
  InvalidNftCanister : text;
  TransactionAddError : text;
  TransferError : text;
  UserIsNotNftOwner : text;
  AlreadyProcessing : text;
  TransactionPreparationError : text;
  InvalidPrincipal : text;
  NotAuthorized : text;
  EmptyArgs : text;
  CallError : text;
  CanisterIsNotNftOwner : text;
  ConfigNotFound : text;
  InvalidPercentage : text;
};
type GeneralFractionalizationConfig = record {
  division : nat64;
  ledger_id : principal;
  swap_fee : nat;
};
// The arguments for the
// [ICRC-3 `icrc3_get_blocks`](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#icrc3_get_blocks)
// endpoint.
type GetBlocksRequest = record { start : nat; length : nat };
// The result type for the
// [ICRC-3 `icrc3_get_blocks`](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#icrc3_get_blocks)
// endpoint.
type GetBlocksResult = record {
  log_length : nat;
  blocks : vec BlockWithId;
  archived_blocks : Vec;
};
// The result type for the
// [ICRC-3 `icrc3_get_blocks`](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#icrc3_get_blocks)
// endpoint.
type GetBlocksResult_1 = record {
  log_length : nat;
  blocks : vec BlockWithId;
  archived_blocks : vec ArchivedBlocks;
};
type GetBridgeEvmSignersResponse = record {
  // EIP-55 address of the claims key (`icpSigner`), once loaded.
  claims : opt text;
  // EIP-55 address of the admin key (`adminSigner`), once loaded.
  admin : opt text;
};
// The information returned as part of the return value for the
// [`icrc3_get_archives`](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md)
// endpoint.
type ICRC3ArchiveInfo = record {
  end : nat;
  canister_id : principal;
  start : nat;
};
// Configuration for the ICRC3 implementation.
// 
// This struct contains all the necessary configuration parameters for the ICRC3 implementation,
// including supported block types and system constants.
// 
// # Examples
// 
// ```rust
// use icrc3_library::config::{ICRC3Config, ICRC3Properties};
// use std::time::Duration;
// 
// let config = ICRC3Config {
// supported_blocks: vec![],
// constants: ICRC3Properties::default(),
// };
// ```
type ICRC3Config = record {
  // System constants and limits
  constants : ICRC3Properties;
  // List of supported block types and their URLs
  supported_blocks : vec SupportedBlockType;
};
// The data certificate returned from the
// [ICRC-3 `icrc3_get_tip_certificate`](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#icrc3_get_tip_certificate)
// endpoint.
type ICRC3DataCertificate = record { certificate : blob; hash_tree : blob };
// System constants and limits for the ICRC3 implementation.
// 
// This struct defines various system parameters that control the behavior
// of the ICRC3 implementation, such as transaction windows, memory limits,
// and cycle management.
type ICRC3Properties = record {
  // Maximum number of blocks per response
  max_blocks_per_response : nat;
  // Initial number of cycles
  initial_cycles : nat;
  // Time window for transaction validation
  tx_window : Duration;
  // Maximum number of transactions to purge at once
  max_transactions_to_purge : nat;
  // Maximum memory size in bytes
  max_memory_size_bytes : nat;
  // ttl for non-archived transactions
  ttl_for_non_archived_transactions : Duration;
  // Maximum number of transactions allowed in the window
  max_transactions_in_window : nat;
  // Maximum number of unarchived transactions
  max_unarchived_transactions : nat;
  // Number of cycles to reserve
  reserved_cycles : nat;
};
// A value defined in [the ICRC-3 standard](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#value).
type ICRC3Value = variant {
  Int : int;
  Map : vec record { text; ICRC3Value };
  Nat : nat;
  Blob : blob;
  Text : text;
  Array : vec ICRC3Value;
};
type Icrc21Error = variant {
  GenericError : record { description : text; error_code : nat };
  InsufficientPayment : ErrorInfo;
  UnsupportedCanisterCall : ErrorInfo;
  ConsentMessageUnavailable : ErrorInfo;
};
type Icrc28TrustedOriginsResponse = record { trusted_origins : vec text };
type InboundStatus = variant {
  Queued;
  // The ledger said TooOld while the outcome was unknown.
  NeedsManualCheck : text;
  // Set by an SNS resolve action.
  Rejected : text;
  Minted : record { icp_block_index : nat64 };
  // The ledger refused the mint, for example because the destination is the minting account.
  Quarantined : text;
  // The ledger outcome is unknown; retried with the same arguments.
  MintUnknown;
};
type InboundTransfer = record {
  to : Account;
  status : InboundStatus;
  token : text;
  log_index : nat64;
  chain : EvmChain;
  evm_from : text;
  block_number : nat64;
  burn_id : nat64;
  discovered_at : nat64;
  tx_hash : text;
  amount : nat;
};
type InitArgs = record {
  buyback_burn_canister : opt Account;
  // Bridge config and chain resets. `None` leaves the bridge unconfigured.
  bridge : opt BridgeUpgrade;
  test_mode : bool;
  authorized_principals : vec principal;
  version : BuildVersion;
  icrc3_config : ICRC3Config;
  gldt_swap_old_archive : principal;
  commit_hash : text;
  swap_configs : vec SwapCanisterConfig;
};
type Nft = record { id : nat; canister_id : principal };
// Outbound transfers not yet settled, by status: the processor's work (`burning`,
// `burn_unknown`, `burned`) and those held for an SNS resolve (`needs_manual_check`).
type OutboundCounts = record {
  needs_manual_check : nat64;
  burn_unknown : nat64;
  burning : nat64;
  burned : nat64;
};
type OutboundStatus = variant {
  Burned : record { icp_burn_index : nat64 };
  Failed : text;
  // The ledger said TooOld while the outcome was unknown.
  NeedsManualCheck : text;
  // The ledger outcome is unknown; retried with the same arguments.
  BurnUnknown;
  Burning;
  Signed : EvmVoucher;
};
type OutboundTransfer = record {
  id : nat64;
  status : OutboundStatus;
  from : Account;
  chain : EvmChain;
  recipient : text;
  created_at : nat64;
  amount : nat;
};
// Inbound transfers not yet settled, by status: the mint queue (`queued`, `mint_unknown`) and
// those held for an SNS resolve (`quarantined`, `needs_manual_check`).
type QueueSizes = record {
  needs_manual_check : nat64;
  mint_unknown : nat64;
  queued : nat64;
  quarantined : nat64;
};
type ResolveAction = variant {
  InboundReject : record {
    token : opt text;
    chain : EvmChain;
    burn_id : nat64;
    reason : text;
  };
  OutboundMarkBurned : record { id : nat64; icp_burn_index : nat64 };
  OutboundMarkFailed : record { id : nat64 };
  InboundMintTo : record {
    to : Account;
    token : opt text;
    chain : EvmChain;
    burn_id : nat64;
  };
  InboundRetry : record { token : opt text; chain : EvmChain; burn_id : nat64 };
  InboundMarkMinted : record {
    // An earlier token of the chain; the current one when `None`.
    token : opt text;
    chain : EvmChain;
    icp_block_index : nat64;
    burn_id : nat64;
  };
};
type Response = variant { Success; InternalError : text };
type Result = variant { Ok : OutboundTransfer; Err : BridgeError };
type Result_1 = variant {
  Ok : vec record { principal; vec nat };
  Err : GeneralError;
};
type Result_2 = variant { Ok : vec nat; Err : GeneralError };
type Result_3 = variant { Ok : ConsentInfo; Err : Icrc21Error };
type Result_4 = variant { Ok : vec nat; Err : SwapNftForTokensErrors };
type Result_5 = variant { Ok : vec nat; Err : SwapTokensForNftErrors };
type Result_6 = variant { Ok : text; Err : text };
type Severity = variant { Info; Critical; Warning };
type SignedEvmAdminAction = record {
  id : nat64;
  token : text;
  // `0x` and 65 bytes of hex.
  signature : text;
  calls : vec EvmCall;
  chain : EvmChain;
  description : text;
  // Unix seconds.
  deadline : nat64;
  created_at : nat64;
  chain_id : nat64;
  nonce : nat64;
};
// Both sides of the supply guard: minting holds while `evm_side > icp_side`.
type SupplyGuardStatus = record {
  // The sum of the chains' supply readings plus every unminted inbound burn.
  evm_side : nat;
  // `bridged_out`.
  icp_side : nat;
  holding : bool;
};
type SupplyReadingStatus = record { block : nat64; total_supply : nat };
// The return type of the
// [ICRC-3 `icrc3_supported_block_types`](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#icrc3_supported_block_types)
// endpoint.
type SupportedBlockType = record { url : text; block_type : text };
type SupportedStandard = record { url : text; name : text };
type SwapCanisterConfig = record {
  icrc7_canister_id : principal;
  fractionalization_config : FractionalizationConfig;
};
type SwapInfo = record {
  nft : Nft;
  status : SwapStatus;
  created_at : nat64;
  tokens_amount : GeneralFractionalizationConfig;
  user_account : Account;
  index : nat;
  swap_type : SwapType;
};
type SwapNftForTokensErrors = variant {
  Limit : text;
  GeneralError : GeneralError;
  Retry : record { nat64; text };
  CantBeAnonymous : text;
};
type SwapStatus = variant {
  Burned;
  Failed : text;
  NftTransferredFrom;
  Init;
  NftTransferred;
  Complete;
  BurnFailed : text;
  ReimburseFailed : text;
  Minted;
  NftTransferFailed : text;
  NftTransferFromFailed : text;
  Reimbursed;
  MintFailed : text;
};
type SwapTokensForNftErrors = variant {
  Limit : text;
  GeneralError : GeneralError;
  Retry : record { nat64; text };
  NotOwnedBySwapCanister;
  SwapCreationError;
};
type SwapType = variant { Forward; Reverse };
// The error return type for the
// [ICRC-2 `transfer_from`](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-2/README.md#icrc2_transfer_from)
// endpoint.
type TransferFromError = variant {
  GenericError : record { message : text; error_code : nat };
  TemporarilyUnavailable;
  InsufficientAllowance : record { allowance : nat };
  BadBurn : record { min_burn_amount : nat };
  Duplicate : record { duplicate_of : nat };
  BadFee : record { expected_fee : nat };
  CreatedInFuture : record { ledger_time : nat64 };
  TooOld;
  InsufficientFunds : record { balance : nat };
};
type UpgradeArgs = record {
  // Replaces the bridge config and restarts stopped chains. `None` keeps the bridge as it is.
  bridge : opt BridgeUpgrade;
  version : BuildVersion;
  commit_hash : text;
};
type Value = variant {
  Text : record { content : text };
  TokenAmount : record { decimals : nat8; amount : nat64; symbol : text };
  TimestampSeconds : record { amount : nat64 };
  DurationSeconds : record { amount : nat64 };
};
type Vec = vec record {
  args : vec record { start : nat; length : nat };
  callback : func (vec record { start : nat; length : nat }) -> (
      record {
        log_length : nat;
        blocks : vec record {
          id : nat;
          block : variant {
            Int : int;
            Map : vec record { text; ICRC3Value };
            Nat : nat;
            Blob : blob;
            Text : text;
            Array : vec ICRC3Value;
          };
        };
        archived_blocks : Vec;
      },
    ) query;
};
type WindowStatus = record {
  to_block : nat64;
  end_burn_id : nat64;
  total_supply : nat;
};
service : (Args_1) -> {
  // Authorized principals can pause either direction but never unpause;
  // unpausing is an SNS `SetIcpPaused` action.
  bridge_pause : (BridgePauseArgs) -> ();
  // The bridge's SNS generic function, for ORIGYN SNS governance only. The action is
  // checked again on the current state, and any error traps, so the proposal shows as failed.
  bridge_sns_action : (BridgeSnsAction) -> ();
  // Burns the caller's GLDT on ICP and signs a claim voucher for Ethereum or Base.
  // The caller first approves `gldt_swap` for `amount` on the GLDT ledger.
  bridge_to_evm : (BridgeToEvmArgs) -> (Result);
  commit : () -> ();
  get_active_swap_ids_by_user : (opt principal) -> (vec nat) query;
  get_active_swaps : (null) -> (vec record { nat; SwapInfo }) query;
  get_active_swaps_by_ids : (vec nat) -> (vec record { nat; SwapInfo }) query;
  get_active_swaps_by_user : (opt principal) -> (
      vec record { nat; SwapInfo },
    ) query;
  get_available_nfts : (opt principal) -> (Result_1);
  get_available_nfts_for_canister : (Args) -> (Result_2);
  // One signed admin action: anyone may submit it with `execute` on the token before its
  // deadline.
  get_bridge_admin_action : (nat64) -> (opt SignedEvmAdminAction) query;
  // Signed admin actions, newest first. `start` is an exclusive upper bound on the id (the last
  // id of the previous page); `limit` is capped at 100.
  get_bridge_admin_actions : (opt nat64, nat32) -> (
      vec SignedEvmAdminAction,
    ) query;
  // The EIP-55 addresses of the claims and admin keys, once loaded.
  get_bridge_evm_signers : () -> (GetBridgeEvmSignersResponse) query;
  get_bridge_status : () -> (BridgeStatus) query;
  // The inbound transfer of burn `burn_id` on the chain's current token.
  get_bridge_transfer_in : (EvmChain, nat64) -> (opt InboundTransfer) query;
  // One outbound transfer. The frontend polls it until the status is `Signed`, then submits the
  // voucher with `claimFromIcp`. Vouchers never expire.
  get_bridge_transfer_out : (nat64) -> (opt OutboundTransfer) query;
  // The account's inbound transfers, newest first. `start` skips that many (the number already
  // shown); `limit` is capped at 100.
  get_bridge_transfers_in_by_account : (Account, opt nat64, nat32) -> (
      vec InboundTransfer,
    ) query;
  // The saved burns of an EVM transaction, in burn id order. Lookup only: it never fetches.
  get_bridge_transfers_in_by_tx : (EvmChain, text) -> (
      vec InboundTransfer,
    ) query;
  // The account's outbound transfers, newest first. `start` is an exclusive upper bound on the
  // id (the last id of the previous page); `limit` is capped at 100.
  get_bridge_transfers_out_by_account : (Account, opt nat64, nat32) -> (
      vec OutboundTransfer,
    ) query;
  get_failed_swap_ids_by_user : (opt principal) -> (vec nat) query;
  get_failed_swaps : (null) -> (vec record { nat; SwapInfo }) query;
  get_failed_swaps_by_ids : (vec nat) -> (vec record { nat; SwapInfo }) query;
  get_failed_swaps_by_user : (opt principal) -> (
      vec record { nat; SwapInfo },
    ) query;
  get_swap_configs : (null) -> (vec SwapCanisterConfig) query;
  icrc10_supported_standards : () -> (vec SupportedStandard) query;
  icrc21_canister_call_consent_message : (ConsentMessageRequest) -> (
      Result_3,
    ) query;
  icrc28_trusted_origins : () -> (Icrc28TrustedOriginsResponse);
  icrc3_get_archives : (null) -> (vec ICRC3ArchiveInfo) query;
  icrc3_get_blocks : (vec GetBlocksRequest) -> (GetBlocksResult_1) query;
  icrc3_get_properties : (null) -> (ICRC3Properties) query;
  icrc3_get_tip_certificate : (null) -> (ICRC3DataCertificate) query;
  icrc3_supported_block_types : (null) -> (vec SupportedBlockType) query;
  set_buyback_canister : (opt Account) -> (Response);
  swap_nft_for_tokens : (vec Nft) -> (Result_4);
  swap_tokens_for_nft : (vec Nft) -> (Result_5);
  // The SNS validator of `bridge_sns_action`: the text voters read, or why the action
  // would fail. Open to every caller, so proposers can preview the text; it only reads state.
  // An update, not a query, so SNS governance can call it.
  validate_bridge_sns_action : (BridgeSnsAction) -> (Result_6);
}
